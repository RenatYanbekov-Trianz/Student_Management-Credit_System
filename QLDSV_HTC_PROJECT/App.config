<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Connection string is injected via environment variable DB_CONNECTION_STRING (Kubernetes Secret / AWS Secrets Manager via IRSA).
		     Set DB_CONNECTION_STRING in your Kubernetes Secret or ConfigMap and reference it as an env var in the pod spec.
		     Example: Data Source=${DB_HOST};Initial Catalog=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD} -->
		<add name="QLDSV_HTCConnectionString"
             connectionString=""
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
