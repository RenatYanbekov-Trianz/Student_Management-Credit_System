<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- .NET 8 compatible configuration -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <connectionStrings>
    <add name="QLDSV_HTCConnectionString"
         connectionString="Data Source=Threde\SQLEXPRESS;Initial Catalog=QLDSV_HTC;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
