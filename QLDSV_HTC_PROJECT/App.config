<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cloud Readiness Fix (cr-dotnet-0010 / cr-dotnet-0013):
  The hardcoded connection string has been removed.  Connection strings and
  other environment-specific configuration are now resolved at runtime from:

    1. Environment variable  QLDSV_HTC_CONNECTION_STRING
       (set by ECS task definition, EC2 user-data, or local .env file)

    2. AWS Systems Manager Parameter Store
       Path: /qldsv-htc/db/connection-string
       (requires an IAM role with ssm:GetParameter permission)

  Web.config / App.config build-time transformations (Web.Debug.config,
  Web.Release.config) are no longer used.  Configuration is injected at
  runtime, enabling immutable deployments and true infrastructure-as-code.

  See DAL/DatabaseConnection.cs and DAL/AwsParameterStoreHelper.cs for the
  runtime resolution logic.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!--
    connectionStrings section intentionally left empty.
    All connection strings are resolved at runtime from environment variables
    or AWS Systems Manager Parameter Store.
  -->
</configuration>
