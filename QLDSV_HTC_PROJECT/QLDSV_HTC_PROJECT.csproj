<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Updated from net6.0-windows to net8.0-windows for .NET 8 compatibility -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>QLDSV_HTC</RootNamespace>
    <AssemblyName>QLDSV_HTC_PROJECT</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Suppress nullable warnings for legacy WinForms designer code -->
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604</NoWarn>
    <!-- Enable Windows-specific APIs -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- .NET 8 specific: configure invariant globalization -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Enable Windows targeting when building on non-Windows OS -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient replaces System.Data.SqlClient for .NET 8 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.1" />
    <!-- System.Configuration.ConfigurationManager for App.config support in .NET 8 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

</Project>
