<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>QLDSV_HTC_PROJECT</RootNamespace>
    <AssemblyName>QLDSV_HTC_PROJECT</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company></Company>
    <Product>QLDSV_HTC_PROJECT</Product>
    <Copyright>Copyright © 2025</Copyright>
    <!-- Suppress duplicate assembly attribute errors from Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Required to build Windows-targeting projects on non-Windows OS -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.SqlClient replaces System.Data.SqlClient for .NET 8 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- System.Configuration.ConfigurationManager for App.config support in .NET 8 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
